<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AurApp" parent="Theme.AppCompat.NoActionBar">
        <!-- The same pink as the web app's background, so the split second
             before the WebView paints is not a white flash. -->
        <item name="android:windowBackground">@color/launch</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@color/launch</item>
        <item name="android:navigationBarColor">@color/launch</item>
    </style>
</resources>
